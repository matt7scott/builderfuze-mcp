# Required: at least 32 random bytes — used to sign JWT access tokens
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Public URL of THIS server (where Claude reaches us)
# - Local dev:  http://localhost:3001
# - Production: https://mcp.builderfuze.com
MCP_PUBLIC_URL=https://mcp.builderfuze.com

# BuilderFuze base URL (for OAuth consent redirect)
BUILDERFUZE_BASE_URL=https://builderfuze.vercel.app

# BuilderFuze API URL (for tool calls — usually same as above)
BUILDERFUZE_API_URL=https://builderfuze.vercel.app

# Set to "false" to skip auth (dev only — never in prod)
# MCP_REQUIRE_AUTH=false
